generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Criteria {
  id          String   @id @default(cuid())
  name        String
  weight      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model House {
  id             String   @id @default(cuid())
  title          String?
  description    String?
  energyLabel    String?
  livingArea     Float?
  plotSize       Float?
  price          Float?
  address        String?
  listingStatus  String?
  latitude       Float?
  longitude      Float?
  imagePath        String?
  images           String[]
  sourceFileName   String?
  rawText          String?
  documentAnalysis Json?
  source         String   @default("upload")
  fundaId        String?  @unique
  fundaUrl       String?
  searchProfileId String?
  searchProfile  SearchProfile? @relation(fields: [searchProfileId], references: [id], onDelete: SetNull)
  status         String   @default("ready")
  error          String?
  progress       Int      @default(0)
  progressLabel  String?
  createdAt      DateTime @default(now())
  scores         Score[]
}

model SearchProfile {
  id            String   @id @default(cuid())
  name          String
  cities        String[]
  priceMin      Float?
  priceMax      Float?
  objectTypes   String[] @default(["house"])
  livingAreaMin Float?
  enabled       Boolean  @default(true)
  lastRunAt     DateTime?
  lastRunStatus String?
  lastRunError  String?
  lastRunCount  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  houses        House[]
}

model Score {
  id               String   @id @default(cuid())
  houseId          String
  house            House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  total            Float
  criteriaSnapshot Json
  rationale        String?
  createdAt        DateTime @default(now())

  @@index([houseId])
}
