{
  "name": "houser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"bun --watch src/server/index.ts\" \"vite\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "bun src/server/index.ts",
    "lint": "eslint ."
  },
