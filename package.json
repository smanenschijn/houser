    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.102.2",
    "ai": "^7.0.77",
    "croner": "^10.0.1",
    "hono": "^4.7.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
